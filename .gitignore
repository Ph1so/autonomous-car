# Slamtec SDK build output. The SDK's own .gitignore is what keeps the
# submodule clean; git doesn't apply this file inside a submodule.
third_party/rplidar_sdk/output/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Raw videos and older demos stay out of the repo; the README links
# GitHub-hosted copies. New lidar GIFs in media/ aren't ignored.
media/*.mov
media/*.mp4
media/2026-10-22-rear-motors.gif
media/2026-10-23-steering-servo.gif
